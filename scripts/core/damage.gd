class_name Damage
extends RefCounted
## Типы урона. Каждый блок по-разному сопротивляется каждому типу:
## например, камень плохо пробивается пулями, а дерево хорошо горит от взрыва.
## Сейчас используется только MELEE (удар рукой/инструментом),
## остальные заложены заранее — для оружия, пушек и осад.

enum {
	MELEE,     ## удар рукой, киркой, мечом
	BULLET,    ## пуля, стрела
	EXPLOSION, ## взрыв, пушечное ядро
}

const NAMES := {
	MELEE: "Удар",
	BULLET: "Пуля",
	EXPLOSION: "Взрыв",
}

## Урон одного удара рукой. Позже у каждого инструмента будет свой.
const HAND := 3.0
## Сколько раз в секунду можно бить, если держать кнопку.
const HITS_PER_SECOND := 5.0
## Больше этого за один удар сервер не примет (защита от жульничества).
const MAX_PER_HIT := 100.0
